.gitignore
.DS_Store
TR-1um/
script/__pycache__
__pycache__/

# Cowork の受け渡し用フォルダ（リポジトリの正本ではない）
Claude outputs/

# 特性化デッキの展開先。genjobs.py + runjobs.sh でいつでも作り直せる
scripts/char/pack/
scripts/char/pack_rslatch/
scripts/char/decks/
scripts/char/logs/

# P&R の受け渡し用 tarball（cloud <-> Mac）
.pnr_stage/

# チップ ngspice の波形生データ
layout/chip/simulation/*.raw.csv

# mklib.py が .lib を作り直すときに取る退避
lef/*.lib.bak

# TB が吐く波形（iverilog の $dumpfile がリポジトリ直下に落とす）
*.vcd

# PDK DRC のレポート（drc_pdk.py が作る生成物）
*_drc.lyrdb
DRC_error.lyrdb

# LVS レポート（再生成できる。KLayout で開く用）
*.lvsdb

# ngspice の中間・ログ（再生成できる）
layout/chip/simulation/*_extracted.spice
layout/chip/simulation/*.log

# CI が src/ に吐くもの（再生成できる）
src/*.lyrdb
src/*.lvsdb
src/*.extracted
mdp/

# 配線 step6 の内部チェックポイント（5 本。route.py が毎回作り直す）
layout/step6/

# MDP のマスクデータ（drc_pdk.py --mdp が起こす。5 MB / 再生成できる）
src/*_mdp.gds

# mklvsnet.py が 2026-09-15 まで書いていた場所（TD4 のマクロ向き由来）。
# 既定は layout/chip/simulation/ に直したので、残っていたら古い生成物。
layout/landscape/
layout/portrait/

